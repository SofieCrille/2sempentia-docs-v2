{
    "source": {
        "include": ["src"],
        "includePattern": ".js$",
        "exclude": ["node_modules", "src/views", "src/components", "src/App.vue", "src/main.js"]
    },
    "opts": {
        "destination": "./docs",
        "recurse": true,
        "tutorials": "./tutorials",
        "template": "node_modules/docdash"
    },
    "docdash": {
        "tutorialsLabel": "Projekt Dokumentation"
    }
}